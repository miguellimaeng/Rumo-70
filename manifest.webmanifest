{
  "name": "Rumo aos 70 kg",
  "short_name": "Rumo 70",
  "description": "Acompanhamento do plano de emagrecimento: peso, treino, comida e exames.",
  "lang": "pt-BR",
  "start_url": "./#hoje",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#3A0B52",
  "theme_color": "#3A0B52",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/*",
            "text/plain"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Registrar peso",
      "short_name": "Peso",
      "url": "./?a=peso#hoje",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Começar treino",
      "short_name": "Treino",
      "url": "./#treino",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Adicionar refeição",
      "short_name": "Comida",
      "url": "./#comida",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Painel e previsão",
      "short_name": "Painel",
      "url": "./#painel",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}